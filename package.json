{
  "name": "flam-frontend-assignment",
  "private": true,
  "version": "1.0.0",
  "description": "Study Deck — a text-to-flashcards/quiz React app backed by an LLM proxy server.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "start": "concurrently -n server,client -c green,blue \"npm:dev:server\" \"npm:dev:client\"",
    "build": "npm run build -w client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
